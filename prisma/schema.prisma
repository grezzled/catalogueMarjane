generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Catalogue {
  id                   String          @id @default(uuid())
  title                String
  store                String          @default("marjane")
  slug                 String          @unique
  description          String?
  type                 String          @default("weekly")
  language             String          @default("fr")
  startDate            DateTime
  endDate              DateTime
  status               String          @default("UPLOADED")
  paused               Boolean         @default(false)
  pdfPath              String?
  pdfHash              String?         @unique
  sourceUrl            String?
  pageCount            Int             @default(0)
  processedPages       Int             @default(0)
  productCount         Int             @default(0)
  offerCount           Int             @default(0)
  articleCount         Int             @default(0)
  aiProcessingProgress Float           @default(0)
  errorMessage         String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  // Per-catalogue OG image overrides (null/empty = inherit global OGSettings)
  ogBannerTitle      String?
  ogBannerTitleAr    String?
  ogBannerSubtitle   String?
  ogBannerSubtitleAr String?
  ogBodyText         String?
  ogBodyTextAr       String?
  // Number of first pages joined as OG background (null = inherit global)
  ogCoverPages       Int?
  // OG image language override: "fr" | "ar" (null = inherit global)
  ogLang             String?
  aiJobs               AIJob[]
  articles             Article[]
  pages                CataloguePage[]
  offers               Offer[]
  comments             Comment[]

  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@index([slug])
}

model CataloguePage {
  id            String    @id @default(uuid())
  catalogueId   String
  pageNumber    Int
  imagePath     String?
  extractedText String?
  aiAnalysis    String?
  pageType      String?
  category      String?
  productCount  Int       @default(0)
  status        String    @default("PENDING")
  aiModel       String?
  confidence    Float?
  processedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  catalogue     Catalogue @relation(fields: [catalogueId], references: [id], onDelete: Cascade)
  offers        Offer[]

  @@unique([catalogueId, pageNumber])
  @@index([catalogueId])
  @@index([status])
}

model Product {
  id              String           @id @default(uuid())
  name            String
  normalizedName  String
  slug            String?          @unique
  // Smart dedup identity (see src/services/product-identity.ts).
  // identityKey = brand + model + size + variant + sorted core tokens.
  identityKey     String?
  modelNumber     String?
  size            String?
  sizeNum         Float?
  variant         String?
  coreName        String?
  brand           String?
  category        String
  subcategory     String?
  specifications  String?
  imageUrl        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  articleProducts ArticleProduct[]
  offers          Offer[]
  comments        Comment[]
  reviews         Review[]

  @@index([normalizedName])
  @@index([identityKey])
  @@index([modelNumber])
  @@index([category])
  @@index([brand])
}

model Offer {
  id                 String        @id @default(uuid())
  productId          String
  catalogueId        String
  cataloguePageId    String
  originalPrice      Float?
  salePrice          Float?
  currency           String        @default("MAD")
  discountAmount     Float?
  discountPercentage Float?
  installmentAmount  Float?
  installmentMonths  Int?
  availability       String?
  conditions         String?
  promotionalDates   String?
  confidence         Float?
  startDate          DateTime
  endDate            DateTime
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  cataloguePage      CataloguePage @relation(fields: [cataloguePageId], references: [id], onDelete: Cascade)
  catalogue          Catalogue     @relation(fields: [catalogueId], references: [id], onDelete: Cascade)
  product            Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([catalogueId])
  @@index([productId])
  @@index([startDate])
  @@index([endDate])
}

model Category {
  id          String            @id @default(uuid())
  name        String            @unique
  slug        String            @unique
  description String?
  parentId    String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  articles    ArticleCategory[]

  @@index([slug])
}

model Article {
  id                   String            @id @default(uuid())
  title                String
  slug                 String            @unique
  metaTitle            String?
  metaDescription      String?
  excerpt              String?
  content              String
  contentHtml          String?
  // Structured FAQ (JSON array of {question, answer}) — also emitted as FAQPage schema
  faq                  String?
  primaryKeyword       String?
  secondaryKeywords    String?
  searchIntent         String?
  catalogueId          String?
  // Generation intent: overview | category_focus | top_deals | budget | buying_guide
  articleType          String            @default("overview")
  // Focus category for category-scoped types (category_focus, buying_guide)
  articleFocus         String?
  status               String            @default("DRAFT")
  seoScore             Float?
  contentQualityScore  Float?
  originalityScore     Float?
  factualAccuracyScore Float?
  searchIntentScore    Float?
  thinContentRisk      Float?
  keywordStuffingRisk  Float?
  recommendation       String?
  publishedAt          DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  catalogue            Catalogue?        @relation(fields: [catalogueId], references: [id])
  articleCategories    ArticleCategory[]
  incomingLinks        ArticleLink[]     @relation("LinkedArticles")
  outgoingLinks        ArticleLink[]     @relation("ArticleLinks")
  articleProducts      ArticleProduct[]
  seoAnalysis          SEOAnalysis?
  comments             Comment[]

  @@index([slug])
  @@index([status])
  @@index([catalogueId])
  @@index([primaryKeyword])
}

model ArticleProduct {
  id        String  @id @default(uuid())
  articleId String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, productId])
  @@index([articleId])
  @@index([productId])
}

model ArticleCategory {
  id         String   @id @default(uuid())
  articleId  String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  article    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, categoryId])
  @@index([articleId])
  @@index([categoryId])
}

model ArticleLink {
  id              String  @id @default(uuid())
  sourceArticleId String
  targetArticleId String
  anchorText      String?
  targetArticle   Article @relation("LinkedArticles", fields: [targetArticleId], references: [id], onDelete: Cascade)
  sourceArticle   Article @relation("ArticleLinks", fields: [sourceArticleId], references: [id], onDelete: Cascade)

  @@unique([sourceArticleId, targetArticleId])
  @@index([sourceArticleId])
  @@index([targetArticleId])
}

model AIJob {
  id           String     @id @default(uuid())
  type         String
  catalogueId  String?
  pageId       String?
  articleId    String?
  status       String     @default("PENDING")
  paused       Boolean    @default(false)
  priority     Int        @default(0)
  payload      String?
  result       String?
  errorMessage String?
  retryCount   Int        @default(0)
  maxRetries   Int        @default(3)
  nextRetryAt  DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  catalogue    Catalogue? @relation(fields: [catalogueId], references: [id], onDelete: Cascade)

  @@index([status, type])
  @@index([catalogueId])
  @@index([status, priority])
  @@index([paused, status])
}

model WorkerSettings {
  id        String   @id @default("singleton")
  paused    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SearchConsoleRow {
  id              String    @id @default(uuid())
  url             String
  // 28-day aggregate window this snapshot covers
  windowStart     DateTime
  windowEnd       DateTime
  clicks          Int       @default(0)
  impressions     Int       @default(0)
  ctr             Float     @default(0)
  position        Float     @default(0)
  // URL Inspection verdict (on-demand, quota-limited): e.g. PASS / PARTIAL / FAIL / NEUTRAL
  indexVerdict    String?
  indexDetail     String?
  inspectedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([url, windowStart, windowEnd])
  @@index([url])
  @@index([impressions])
}

model SEOAnalysis {
  id        String   @id @default(uuid())
  articleId String   @unique
  analysis  String
  score     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

model OGSettings {
  id               String   @id @default("singleton")
  bannerTitle      String   @default("Catalogue Marjane")
  bannerTitleAr    String   @default("كتالوج مرجان")
  bannerSubtitle   String   @default("Promotions et Offres")
  bannerSubtitleAr String   @default("عروض وتوصيل")
  bodyText         String   @default("Promotions et Offres au Maroc")
  bodyTextAr       String   @default("عروض وتوصيل في المغرب")
  // Default number of first catalogue pages joined as OG background (1-3)
  coverPages       Int      @default(1)
  // Default OG image language: "fr" | "ar"
  defaultLang      String   @default("fr")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Source {
  id          String    @id @default(uuid())
  name        String
  url         String?   @unique
  type        String?
  lastChecked DateTime?
  isActive    Boolean   @default(true)
  config      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([url])
  @@index([isActive])
}

model Subscriber {
  id               String    @id @default(uuid())
  email            String    @unique
  active           Boolean   @default(true)
  source           String?
  unsubscribeToken String    @unique @default(uuid())
  createdAt        DateTime  @default(now())
  unsubscribedAt   DateTime?

  @@index([active])
}

model Comment {
  id          String    @id @default(uuid())
  targetType  String // "catalogue" | "article" | "product"
  catalogueId String?
  articleId   String?
  productId   String?
  parentId    String?
  author      String
  content     String
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  catalogue   Catalogue? @relation(fields: [catalogueId], references: [id], onDelete: Cascade)
  article     Article?   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  product     Product?   @relation(fields: [productId], references: [id], onDelete: Cascade)
  parent      Comment?   @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[]  @relation("CommentReplies")
  votes       CommentVote[]

  @@index([catalogueId])
  @@index([articleId])
  @@index([productId])
  @@index([parentId])
  @@index([targetType])
}

model CommentVote {
  id        String   @id @default(uuid())
  commentId String
  emoji     String
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([commentId])
}

/// Star ratings for products. Moderated (PENDING → PUBLISHED) like comments.
/// One review per pseudo per product; helpfulness via ReviewVote.
model Review {
  id        String   @id @default(uuid())
  productId String
  author    String
  rating    Int
  title     String?
  content   String
  recommend Boolean?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  votes     ReviewVote[]

  @@index([productId, status])
  @@index([status, createdAt])
}

model ReviewVote {
  id        String   @id @default(uuid())
  reviewId  String
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

/// First-party page views (JS beacon). Pathname only, no PII.
/// Feeds the "Live 24h" dashboard tab; pruned after 90 days by the worker.
model PageView {
  id        String   @id @default(uuid())
  path      String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path, createdAt])
}
